[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/gameplay/player.gd" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/characters/player_visuals.tscn" id="2_visuals"]
[ext_resource type="Script" path="res://scripts/gameplay/player_input.gd" id="3_input"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
radius = 0.35
height = 1.8

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_state"]
properties/0/path = NodePath(".:sync_position")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:sync_yaw")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:sync_pitch")
properties/2/spawn = true
properties/2/replication_mode = 1
properties/3/path = NodePath(".:sync_tick")
properties/3/spawn = true
properties/3/replication_mode = 1
properties/4/path = NodePath(".:display_name")
properties/4/spawn = true
properties/4/replication_mode = 0

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
wall_min_slide_angle = 0.0
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="Visuals" parent="." instance=ExtResource("2_visuals")]

[node name="Head" type="Node3D" parent="."]
