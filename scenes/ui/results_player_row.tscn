[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/results_player_row.gd" id="2_row"]
[ext_resource type="Script" path="res://scripts/ui/widgets/helmet_avatar.gd" id="3_helmet"]

[node name="ResultsPlayerRow" type="VBoxContainer"]
mouse_filter = 2
theme = ExtResource("1_theme")
theme_type_variation = &"VBoxFlush"
script = ExtResource("2_row")

[node name="Content" type="HBoxContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
mouse_filter = 2

[node name="Helmet" type="Control" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("3_helmet")

[node name="Name" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelStrong"
text = "Игрок"
text_overrun_behavior = 3

[node name="SelfTag" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"LabelTagSolid"
text = "Ты"
uppercase = true

[node name="Spacer" type="Control" parent="Content"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="State" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelCaption"
text = "вне игры"

[node name="Rule" type="HSeparator" parent="."]
layout_mode = 2
mouse_filter = 2
