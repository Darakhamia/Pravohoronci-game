[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/hud/hud_role.gd" id="2_role"]

[node name="Role" type="PanelContainer"]
visible = false
size_flags_horizontal = 0
mouse_filter = 2
theme = ExtResource("1_theme")
theme_type_variation = &"HudPanel"
script = ExtResource("2_role")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelOverlineCyan"
text = "Экипаж"
uppercase = true

[node name="Divider" type="VSeparator" parent="Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"VSeparatorHud"

[node name="Partner" type="Label" parent="Row"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"LabelHudSoft"
text = "напарник: —"
text_overrun_behavior = 3
