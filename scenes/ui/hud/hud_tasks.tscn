[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/hud/hud_tasks.gd" id="2_tasks"]

[node name="Tasks" type="PanelContainer"]
visible = false
