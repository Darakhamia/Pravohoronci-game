[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/hud/hud_toasts.gd" id="2_toasts"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud/hud_toast.tscn" id="3_toast"]

