[gd_scene format=3]

[ext_resource type="Theme" path="res://resources/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/lobby_player_row.gd" id="2_row"]
[ext_resource type="Script" path="res://scripts/ui/widgets/helmet_avatar.gd" id="3_helmet"]

[node name="LobbyPlayerRow" type="VBoxContainer"]
size_flags_vertical = 3
mouse_filter = 2
theme = ExtResource("1_theme")
