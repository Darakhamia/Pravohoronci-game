[node name="Helmet" type="Control" parent="Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("3_helmet")

[node name="NameGap" type="Control" parent="Content"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
mouse_filter = 2

[node name="Name" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelStrong"
text = "Игрок"

[node name="TagsGap" type="Control" parent="Content"]
custom_minimum_size = Vector2(16, 0)
layout_mode = 2
mouse_filter = 2

[node name="Tags" type="HBoxContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"HBoxTight"

[node name="SelfTag" type="Label" parent="Content/Tags"]
unique_name_in_owner = true
layout_mode = 2
